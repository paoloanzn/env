#!/bin/bash

error_exit() {
  echo "Error: $1" >&2
  exit 1
}

echo "Finding npm cache directory..."
CACHE_PATH=$(npm config get cache)


if [ -z "$CACHE_PATH" ]; then
  error_exit "Could not determine npm cache path. Is npm installed and configured correctly?"
fi

if [ ! -d "$CACHE_PATH" ]; then
  echo "Cache directory specified by npm ($CACHE_PATH) does not seem to exist."
  echo "Nothing to delete."
  exit 0
fi

echo "Calculating cache size..."
CACHE_SIZE_INFO=$(du -sh "$CACHE_PATH")
DU_EXIT_CODE=$?

if [ $DU_EXIT_CODE -ne 0 ]; then
  error_exit "Could not calculate cache size. Check permission for '$CACHE_PATH'."
fi

# Display info
echo
echo "-------------------------------------------"
echo " NPM Cache Information:"
echo "    Path: $CACHE_PATH"
echo "    Size: $(echo "$CACHE_SIZE_INFO" | awk '{print $1}')" # extract only the size
echo "-------------------------------------------"
echo


read -r -p "Do you want to completely delete this npm cache? [y/N]: " response
echo

# Convert response to lowercase
response_lower=$(echo "$response" | tr '[:upper:]' '[:lower:]')

if [[ "$response_lower" == "y" ]]; then
    echo "Deleting npm cache at '$CACHE_PATH'..."
    rm -rf "$CACHE_PATH"
    RM_EXIT_CODE=$?

    if [ $RM_EXIT_CODE -eq 0 ]; then
      echo "NPM cache successfully deleted."
    else
      error_exit "Failed to delete cache. Check permissions or if files/directory are in use."
    fi
else
  echo "Aborted. NPM cache was not deleted."
fi

exit 0
    




